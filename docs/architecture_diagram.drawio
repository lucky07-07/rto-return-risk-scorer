<mxfile host="app.diagrams.net" type="device">
  <diagram name="Architecture" id="rto-arch">
    <mxGraphModel dx="1400" dy="820" grid="0" gridSize="10" guides="1" tooltips="1" connect="1"
                  arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620"
                  math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="COD Return-Risk Scorer" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#12161C;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="From generated data to a scored order a merchant can act on" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6674;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="520" height="20" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;Synthetic order data&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;50,000 orders on the real&lt;br/&gt;India Post pincode map&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF1FA;strokeColor=#1F4F8A;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="&lt;b&gt;Feature engineering&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;address quality, customer&lt;br/&gt;history, area risk&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF1FA;strokeColor=#1F4F8A;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="265" y="110" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="&lt;b&gt;Model training&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;11 models compared,&lt;br/&gt;then tuned&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF1FA;strokeColor=#1F4F8A;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="110" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="&lt;b&gt;Final evaluation&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;held-out test opened once,&lt;br/&gt;cost thresholds fixed&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF1FA;strokeColor=#1F4F8A;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="715" y="110" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="&lt;b&gt;Saved model&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;one file: the model plus&lt;br/&gt;its frozen decision cut-offs&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF3E0;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="715" y="260" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="&lt;b&gt;Scoring service&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;risk score, rupee loss,&lt;br/&gt;decision, reasons&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF3E0;strokeColor=#8A5A00;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="260" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b7" value="&lt;b&gt;Web API&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;scores one order&lt;br/&gt;on request&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6EE;strokeColor=#0F7B3F;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="265" y="260" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b8" value="&lt;b&gt;Merchant page&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;one screen: risk, loss,&lt;br/&gt;decision, reasons&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F6EE;strokeColor=#0F7B3F;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="185" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b9" value="&lt;b&gt;Plain-English layer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#5B6674&quot;&gt;Gemini rewrites the result&lt;br/&gt;for a non-technical reader&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4EFFB;strokeColor=#6B4FA0;strokeWidth=1.5;dashed=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
