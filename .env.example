# Copy this file to .env and fill in your own values.
# .env is gitignored. Never commit real keys.

# Optional. Powers the plain-English explanation on each scored order.
# Get a free key at https://aistudio.google.com/apikey
# Without it the app still works and falls back to a built-in summary.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Overrides which Gemini model is used.
# Defaults to gemini-flash-latest, an alias Google keeps current.
GEMINI_MODEL=gemini-flash-latest

# Optional. Only needed if you extend this to call Razorpay APIs directly.
# Nothing in this repository requires them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
